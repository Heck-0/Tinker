{
  // Ctrl+Shift+B runs the default build task ("Build & install"). Close the game first:
  // Windows locks the DLL while it is running.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & install",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "Tinker.csproj", "-c", "Release", "-t:Install", "-nologo"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build only",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "Tinker.csproj", "-c", "Release", "-nologo"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Tests",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "tools/tests", "-nologo"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Coverage report",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/coverage.ps1"],
      "problemMatcher": []
    }
  ]
}
