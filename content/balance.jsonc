// Tinker's prices: how much each upgrade costs in the Workshop.
// This file is built into the DLL as the defaults. The copy next to the installed DLL is read on top of
// them, so you can tune that copy without rebuilding; it only needs the values you change.
//
// Price in gold = gold per upgrade (setting) × e^(weight · ratio^curve + strain), no ceiling
//   ratio  = (earlier upgrades + units) · hits / max(value before upgrades, referenceFloor)
//   strain = upgrades the card already has in OTHER values, each with its own family's parameters
// More weight or curve = pricier. Enchantments have their own fixed prices ("enchantments", at the end).
{
  "version": 1,

  // How much upgrades the card already has in other values raise the next price. 0 = none, 1 = in full.
  "strainFactor": 0.8,

  "families": {
    // Trigger tiers (1.7.0): powers and relic hooks priced by how often they pay out (RuleEngine.HookTiers).
    "triggerConstant":   { "weight": 2.2, "curve": 1.3,  "referenceFloor": 2 },  // per card played, hit, Block gain, card drawn
    "triggerTurn":       { "weight": 1.7, "curve": 1.25, "referenceFloor": 2 },  // per turn, damage taken, orb, energy spent
    "triggerOccasional": { "weight": 1.2, "curve": 1.2,  "referenceFloor": 2 },  // per Exhaust / discard, kill, potion
    "triggerCombat":     { "weight": 1.0, "curve": 1.1,  "referenceFloor": 2 },  // once a combat (or turn 1 only)
    "triggerRun":        { "weight": 1.5, "curve": 1.2,  "referenceFloor": 2 },  // rooms, rewards, shop, rest sites
    // Expanded effects: recurring actions and selection, kept apart from flat numbers.
    // percentage is in percentage points. protection is capped at 90 % in play;
    // changing this file can't remove that cap.
    "autoPlay": { "weight": 1.8, "curve": 1.2, "referenceFloor": 2 },
    "generation": { "weight": 1.5, "curve": 1.2, "referenceFloor": 2 },
    "selection": { "weight": 1.6, "curve": 1.2, "referenceFloor": 2 },
    "groupResource": { "weight": 1.8, "curve": 1.2, "referenceFloor": 2 },
    "persistentDraw": { "weight": 1.7, "curve": 1.2, "referenceFloor": 1 },
    "persistentGeneration": { "weight": 1.8, "curve": 1.2, "referenceFloor": 1 },
    "percentage": { "weight": 1.4, "curve": 1.2, "referenceFloor": 25 },
    "persistentEnergy": { "weight": 2.0, "curve": 1.25, "referenceFloor": 1 },
    "persistentOrb": { "weight": 2.0, "curve": 1.25, "referenceFloor": 1 },
    "intangible": { "weight": 1.8, "curve": 1.3, "referenceFloor": 1 },
    "persistentDefense": { "weight": 1.6, "curve": 1.3, "referenceFloor": 1 },
    "protection": { "weight": 4.0, "curve": 1.6, "referenceFloor": 10 },
    "persistentRepeat": { "weight": 2.0, "curve": 1.25, "referenceFloor": 1 },
    "permanentGrowth": { "weight": 1.8, "curve": 1.25, "referenceFloor": 2 },
    "threshold": { "weight": 1.8, "curve": 1.25, "referenceFloor": 2 },
    "duration": { "weight": 1.5, "curve": 1.2, "referenceFloor": 1 },
    "deckRemoval": { "weight": 2.8, "curve": 1.25, "referenceFloor": 1 },
    // blockGrowth: each unit is +10 percentage points. sharedForge: +25.
    "blockGrowth": { "weight": 0.8, "curve": 1.2, "referenceFloor": 5 },
    "sharedForge": { "weight": 1.8, "curve": 1.25, "referenceFloor": 4 },
    "shadowMultiplier": { "weight": 3.0, "curve": 1.3, "referenceFloor": 2 },
    "permanentUpgrade": { "weight": 1.35, "curve": 1.3, "referenceFloor": 1 },
    "generatedStats": { "weight": 1.4, "curve": 1.2, "referenceFloor": 5 },
    "damage":   { "weight": 0.65,  "curve": 1.0, "referenceFloor": 5 },  // damage and Osty's damage
    "block":    { "weight": 0.65,  "curve": 1.0, "referenceFloor": 5 },
    "draw":     { "weight": 1.05,  "curve": 1.1, "referenceFloor": 3 },   // card draw
    "energy":   { "weight": 1.40,  "curve": 1.2, "referenceFloor": 2 },   // energy as an effect, on par with cost
    "repeat":   { "weight": 1.30,  "curve": 1.1, "referenceFloor": 2 },   // repeats
    "enchantRepeat": { "weight": 1.90, "curve": 1.25, "referenceFloor": 1 },
    "enchantFirstRepeat": { "weight": 1.40, "curve": 1.20, "referenceFloor": 1 },
    "enchantFirstDamage": { "weight": 0.50, "curve": 1.0, "referenceFloor": 5 },
    "orb":      { "weight": 1.10,  "curve": 1.2, "referenceFloor": 2 },   // Lightning, Frost, Dark
    "plasma":   { "weight": 1.90,  "curve": 1.25, "referenceFloor": 1 },  // recurring energy: higher risk
    "orbRepeat": { "weight": 1.40, "curve": 1.2, "referenceFloor": 2 },  // extra evocations of the same orb
    "multiplier": { "weight": 1.40, "curve": 1.2, "referenceFloor": 1 },  // "for each" / "equal to": ×1 to ×2 doubles the card
    "scaling":  { "weight": 1.30,  "curve": 1.1, "referenceFloor": 2 },   // Strength, Dexterity, Focus
    "power":    { "weight": 1.05,  "curve": 1.1, "referenceFloor": 3 },  // other powers
    "resource": { "weight": 1.05,  "curve": 1.1, "referenceFloor": 3 },  // gold, healing, max HP, stars...
    "drawback": { "weight": 1.30,  "curve": 1.2, "referenceFloor": 1 },  // values that improve by going down
    "cost":     { "weight": 1.40,  "curve": 1.2, "referenceFloor": 1 },
    "generic":  { "weight": 1.05,  "curve": 1.1, "referenceFloor": 3 }
  },

  // Enchantments the Workshop sells for cards: the game's own enchantments, one per card (the game only
  // offers each on the cards it fits). price = gold (the same on every preset). amount = how strong it
  // comes (the game's shop list and the relics and events that give it). "relic": only offered while you have that relic.
  // A price of 0 or less removes it from the Workshop.
  "enchantments": {
    "Instinct":          { "price": 400, "amount": 1 },  // Attack: double damage
    "TezcatarasEmber":   { "price": 400, "amount": 1 },  // costs 0, Eternal, +3 damage
    "Glam":              { "price": 320, "amount": 1 },  // first play each combat is played an extra time
    "Spiral":            { "price": 280, "amount": 1 },  // basic Strike / Defend: every play is played an extra time
    "Adroit":            { "price": 280, "amount": 3 },  // any card: gain 3 Block per play
    "Momentum":          { "price": 280, "amount": 5 },  // Attack: +5 damage after each play this combat
    "Sown":              { "price": 240, "amount": 1 },  // first play each combat: gain 1 Energy
    "Imbued":            { "price": 240, "amount": 1 },  // Skill: played by itself on turn 1
    "RoyallyApproved":   { "price": 240, "amount": 1 },  // Attack / Skill: Innate and Retain
    "Nimble":            { "price": 240, "amount": 3 },  // Block card: +3 Block per play
    "Sharp":             { "price": 240, "amount": 2 },  // Attack: +2 damage per play
    "Clone":             { "price": 240, "amount": 4 },  // can be copied at rest sites
    "Swift":             { "price": 200, "amount": 2 },  // first play each combat: draw 2
    "SoulsPower":        { "price": 200, "amount": 1 },  // removes Exhaust
    "Corrupted":         { "price": 200, "amount": 1 },  // Attack: ×1.5 damage, you take 2 damage per play
    "SlumberingEssence": { "price": 160, "amount": 1 },  // costs 1 less for each turn it stays in your hand
    "Goopy":             { "price": 160, "amount": 1 },  // Defend: gains Exhaust, +1 Block forever after each play
    "Inky":              { "price": 160, "amount": 1 },  // apply 1 Weak per play
    "Steady":            { "price": 160, "amount": 1 },  // Retain
    "Vigorous":          { "price": 160, "amount": 5 },  // Attack: +5 damage on its first play each combat
    "PerfectFit":        { "price": 120, "amount": 1 },  // goes on top of the draw pile when it's shuffled
    "Slither":           { "price": 80,  "amount": 1 }   // random cost (0-3) each time it's drawn
  }
}
